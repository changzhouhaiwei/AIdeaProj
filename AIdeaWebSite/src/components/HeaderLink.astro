---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const base = import.meta.env.BASE_URL;
const raw = String(href ?? '');
const suffix = raw === '/' || raw === '' ? '' : raw.replace(/^\//, '');
const resolvedHref = suffix ? `${base}${suffix}` : base;

const trim = (p: string) => {
	const s = p.replace(/\/+$/, '') || '/';
	return s;
};
const current = trim(Astro.url.pathname);
const target = trim(resolvedHref);
const isActive =
	target === current || (raw !== '/' && current.startsWith(`${target}/`));
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
