{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "商店2 UI 布局与切图说明",
  "description": "依据 ui整图rule.md：画布 720×1556，与 商店2.png 一致；元素需单独导出并带透明通道。坐标为设计稿像素，若与实图有偏差请在编辑器中对齐校准。",
  "meta": {
    "sourceImage": "商店2.png",
    "canvas": { "width": 720, "height": 1556 },
    "ruleFile": "ui整图rule.md",
    "notes": [
      "全屏底图可与列表区拆分，避免重复绘制。",
      "绿色购买按钮样式一致时可只切一份九宫格或单图复用。",
      "货币条四格结构相同可切「槽位底」+「图标」分别拼装。"
    ]
  },
  "layers_z_order_bottom_to_top": [
    "bg_main_navy",
    "header_background_stripes",
    "header_scallop_edge",
    "list_cards",
    "header_currency_row",
    "header_title_shop",
    "btn_back"
  ],
  "regions": {
    "bg_main_navy": {
      "name": "主内容区深蓝底",
      "rect": { "x": 0, "y": 292, "w": 720, "h": 1264 },
      "slice": { "alpha": true, "optional": true, "note": "若程序用纯色可不切，仅标注高度。" }
    },
    "header_background_stripes": {
      "name": "顶栏紫蓝竖条背景",
