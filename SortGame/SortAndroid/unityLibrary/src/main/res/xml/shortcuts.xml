<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toggle_game"
        android:enabled="true"
        android:icon="@android:drawable/ic_media_play"
        android:shortcutShortLabel="@string/shortcut_toggle_game_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.sort.game"
            android:targetClass="com.unity3d.player.UnityPlayerActivity">
            <extra android:name="action" android:value="toggle_game"/>
        </intent>
        <categories android:name="android.shortcut.conversation"/>
    </shortcut>
</shortcuts>
