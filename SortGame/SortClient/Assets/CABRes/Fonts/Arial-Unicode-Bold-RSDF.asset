      \uADF8\uC911 \uD558\uB098\uC784\uC5D0 \uD2C0\uB9BC\uC5C6\uC2B5\uB2C8\uB2E4.\",\"\u041E\u0433\u043E!
      \u041B\u0438\u0448\u0435 <color #fffd3f>{0}</color> \u0433\u0440\u0430\u0432\u0446\u0456\u0432
      \u043F\u0440\u043E\u0439\u0448\u043B\u0438, \u0430\u043B\u0435 \u0442\u0438,
      \u043C\u0430\u0431\u0443\u0442\u044C, \u043E\u0434\u0438\u043D \u0456\u0437
      \u043D\u0438\u0445.\",,\r\nUI_FreeCoin_Des,Text,,Watch a Video to Earn Coins!,\xA1Mira
      un v\xEDdeo para ganar monedas!,Assista a um v\xEDdeo para ganhar moedas!,\"\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432\u0438\u0434\u0435\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442\u044B!\",\"Schau dir ein Video an, um M\xFCnzen
      zu verdienen!\",Regardez une vid\xE9o pour gagner des pi\xE8ces !,M\xFCcevher
      kazanmak i\xE7in bir video izle!,\u89C2\u770B\u89C6\u9891\u8D5A\u91D1\u5E01\uFF01,Tonton
      sebuah video untuk mendapatkan koin!,\u89C0\u770B\u8996\u983B\u8CFA\u91D1\u5E63\uFF01,Guarda
      un video per guadagnare monete!,\u52D5\u753B\u3092\u898B\u3066\u30B3\u30A4\u30F3\u3092\u7372\u5F97\uFF01,\uB3D9\uC601\uC0C1\uC744
      \uC2DC\uCCAD\uD558\uACE0 \uCF54\uC778\uC744 \uD68D\uB4DD\uD558\uC138\uC694!,\"\u0414\u0438\u0432\u0456\u0442\u044C\u0441\u044F
      \u0432\u0456\u0434\u0435\u043E, \u0449\u043E\u0431 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u043C\u043E\u043D\u0435\u0442\u0438!\",,\r\n,,,,,,,,,,,,,,,,,,\r\nUI_CarouselActivity_ButtonTitle,,,Lucky,Suerte,Sorte,\u0423\u0434\u0430\u0447\u0430,Gl\xFCck,Chance,\u015Eans,Lucky,Lucky,Lucky,Fortuna,Lucky,Lucky,\u0423\u0434\u0430\u0447\u0430,,\r\nUI_revivefree,,,Free
