      \uC2DC\uB3C4,\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0449\u0435
      \u0440\u0430\u0437,,\r\nUINoNetworkButton2,Text,,No Ads,Sin anuncios,Sem an\xFAncios,\u0411\u0435\u0437
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B,Keine Werbung,Pas de pub,Reklam
      yok,\u65E0\u5E7F\u544A,Tanpa Iklan,\u7121\u5EE3\u544A,Nessuna pubblicit\xE0,\u5E83\u544A\u306A\u3057,\uAD11\uACE0
      \uC5C6\uC74C,\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u0438,,\r\nUIRemoveAdsGiftTitle,Text,,Remove
      Ads,Sin Anuncios\u200B,Sem An\xFAncios\u200B,\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B\u200B,Werbung
      aus\u200B,Sans Pub\u200B,Reklams\u0131z\u200B,\u79FB\u9664\u5E7F\u544A,Tanpa
      Iklan\u200B,\u79FB\u9664\u5EE3\u544A,Senza Pubblicit\xE0\u200B,\u5E83\u544A\u3092\u524A\u9664,\uAD11\uACE0
      \uC81C\uAC70,\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u0438\u200B,,\r\nUIRemoveAdsGiftTitle2,Text,,Remove
      <color=#FFF851>ADS</color>,Eliminar <color=#FFF851>anuncios</color>,Remover
      <color=#FFF851>an\xFAncios</color>,\u0423\u0431\u0440\u0430\u0442\u044C <color=#FFF851>\u0420\u0415\u041A\u041B\u0410\u041C\u0423</color>,<color=#FFF851>WERBUNG</color>
      entfernen,Supprimer les <color=#FFF851>pubs</color>,<color=#FFF851>Reklamlar\u0131</color>
      kald\u0131r,\u79FB\u9664 <color=#FFF851>\u5E7F\u544A</color>,Hapus <color=#FFF851>IKLAN</color>,\u79FB\u9664
      <color=#FFF851>\u5EE3\u544A</color>,Rimuovi <color=#FFF851>ADS</color>,<color=#FFF851>\u5E83\u544A</color>\u3092\u524A\u9664,<color=#FFF851>\uAD11\uACE0</color>
      \uC81C\uAC70,\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438 <color=#FFF851>\u0420\u0415\u041A\u041B\u0410\u041C\u0423</color>,,\r\nUIRemoveAdsGiftDes,Text,,\"Remove
      <color=#fff773>banner</color> and <color=#fff773>pop-up ads</color>, while
      still keeping ads to earn rewards and promotional offers.\\n\",\"Elimina <color=#fff773>anuncios
      de banner</color> y <color=#fff773>emergentes</color>, mientras mantienes anuncios
      para ganar recompensas y ofertas promocionales.\\n\",\"Elimina <color=#fff773>anuncios
      de banner</color> y <color=#fff773>emergentes</color>, mientras mantienes anuncios
      para ganar recompensas y ofertas promocionales.\\n\",\"\u0423\u0431\u0435\u0440\u0438\u0442\u0435
      <color=#fff773>\u0431\u0430\u043D\u043D\u0435\u0440\u044B</color> \u0438 <color=#fff773>\u0432\u0441\u043F\u043B\u044B\u0432\u0430\u044E\u0449\u0443\u044E
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443</color>, \u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u0435
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434 \u0438 \u043F\u0440\u043E\u043C\u043E-\u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439.\",\"Entfernen
      Sie <color=#fff773>Banner</color> und <color=#fff773>Pop-up-Werbung</color>,
      w\xE4hrend Sie weiterhin Werbung behalten, um Belohnungen und Werbeaktionen
      zu erhalten.\",\"\u201C Supprimez les <color=#fff773>banni\xE8res</color> et
      les <color=#fff773>pubs contextuelles</color>, tout en conservant les pubs
      pour obtenir des r\xE9compenses et des offres promotionnelles. \u201D\",\"\"\"<color=#fff773>Afi\u015F</color>
      ve <color=#fff773>a\xE7\u0131l\u0131r reklamlar\u0131</color> kald\u0131r\u0131n,
      \xF6d\xFCller ve promosyon teklifleri kazanmak i\xE7in reklamlar\u0131 tutmaya
      devam edin.\"\"\",\u79FB\u9664 <color=#fff773>\u6A2A\u5E45\u5E7F\u544A</color>
      \u548C <color=#fff773>\u5F39\u51FA\u5E7F\u544A</color>\uFF0C\u540C\u65F6\u4FDD\u7559\u5E7F\u544A\u4EE5\u83B7\u53D6\u5956\u52B1\u548C\u4FC3\u9500\u4F18\u60E0\u3002,\"Hapus
      <color=#fff773>iklan banner</color> dan <color=#fff773>iklan pop-up</color>,
      sambil tetap mempertahankan iklan untuk mendapatkan hadiah dan penawaran promosi.\",\u79FB\u9664
      <color=#fff773>\u6A6B\u5E45\u5EE3\u544A</color> \u548C <color=#fff773>\u5F48\u51FA\u5EE3\u544A</color>\uFF0C\u540C\u6642\u4FDD\u7559\u5EE3\u544A\u4EE5\u7372\u53D6\u734E\u52F5\u548C\u4FC3\u92B7\u512A\u60E0\u3002,\"Rimuovi
      <color=#fff773>banner</color> e <color=#fff773>pop-up ads</color>, mantenendo
      comunque alcune pubblicit\xE0 per ottenere ricompense e offerte promozionali.\",<color=#fff773>\u30D0\u30CA\u30FC</color>\u3068<color=#fff773>\u30DD\u30C3\u30D7\u30A2\u30C3\u30D7\u5E83\u544A</color>\u3092\u524A\u9664\u3057\u3064\u3064\u3001\u5831\u916C\u3084\u30D7\u30ED\u30E2\u30FC\u30B7\u30E7\u30F3\u5E83\u544A\u306F\u305D\u306E\u307E\u307E\u53D7\u3051\u53D6\u308C\u307E\u3059\u3002,<color=#fff773>\uBC30\uB108</color>
      \uBC0F <color=#fff773>\uD31D\uC5C5 \uAD11\uACE0</color>\uB97C \uC81C\uAC70\uD558\uBA74\uC11C
      \uBCF4\uC0C1\uACFC \uD504\uB85C\uBAA8\uC158 \uAD11\uACE0\uB294 \uC720\uC9C0\uD558\uC138\uC694.,\"\u0412\u0438\u0434\u0430\u043B\u0456\u0442\u044C
      <color=#fff773>\u0431\u0430\u043D\u0435\u0440\u0438</color> \u0442\u0430 <color=#fff773>\u0441\u043F\u043B\u0438\u0432\u0430\u044E\u0447\u0443
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443</color>, \u0437\u0430\u043B\u0438\u0448\u0430\u044E\u0447\u0438
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0434\u043B\u044F \u043E\u0442\u0440\u0438\u043C\u0430\u043D\u043D\u044F
      \u043D\u0430\u0433\u043E\u0440\u043E\u0434 \u0442\u0430 \u043F\u0440\u043E\u043F\u043E\u0437\u0438\u0446\u0456\u0439.\",,\r\nUIRemoveAdsGiftButton2,Text,,continue
      with ads,Continuar con anuncios,Continuar com an\xFAncios,\u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0441 \u0440\u0435\u043A\u043B\u0430\u043C\u043E\u0439,Mit Werbung fortfahren,continuer
      avec pubs,reklamlarla devam et,\u7EE7\u7EED\u89C2\u770B\u5E7F\u544A,lanjut
      dengan iklan,\u7E7C\u7E8C\u89C0\u770B\u5EE3\u544A,continua con le pubblicit\xE0,\u5E83\u544A\u3042\u308A\u3067\u7D9A\u3051\u308B,\uAD11\uACE0
      \uACC4\uC18D,\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438 \u0437
      \u0440\u0435\u043A\u043B\u0430\u043C\u043E\u044E,,\r\nUIRemoveAdsRewardTitle,Text,,Remove
      Ads Permanently,Eliminar anuncios permanentemente,Remover an\xFAncios permanentemente,\u0423\u0431\u0440\u0430\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430,Werbung
      dauerhaft entfernen,Supprimer d\xE9finitivement les pubs,Reklamlar\u0131 kal\u0131c\u0131
      olarak kald\u0131r,\u6C38\u4E45\u79FB\u9664\u5E7F\u544A,Hapus Iklan Secara
      Permanen,\u6C38\u4E45\u79FB\u9664\u5EE3\u544A,Rimuovi pubblicit\xE0 permanentemente,\u5E83\u544A\u3092\u6C38\u4E45\u306B\u524A\u9664,\uAD11\uACE0\uB97C
      \uC601\uAD6C\uC801\uC73C\uB85C \uC81C\uAC70,\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438,,\r\nUIRemoveAdsRewardDes,Text,,Now
      you can enjoy the game without <color=#fff773>banner ads</color> and <color=#fff773>full-screen
      ads</color>.\\n,Ahora puedes disfrutar del juego sin <color=#fff773>anuncios
      de banner</color> ni <color=#fff773>anuncios a pantalla completa</color>.\\n,Agora
      voc\xEA pode aproveitar o jogo sem <color=#fff773>an\xFAncios em banner</color>
      e sem <color=#fff773>an\xFAncios em tela cheia</color>.\\n,\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
      \u0438\u0433\u0440\u043E\u0439 \u0431\u0435\u0437 <color=#fff773>\u0431\u0430\u043D\u043D\u0435\u0440\u043D\u043E\u0439
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B</color> \u0438 <color=#fff773>\u0440\u0435\u043A\u043B\u0430\u043C\u044B
      \u043D\u0430 \u0432\u0435\u0441\u044C \u044D\u043A\u0440\u0430\u043D</color>.,Jetzt
      k\xF6nnen Sie das Spiel ohne <color=#fff773>Bannerwerbung</color> und <color=#fff773>Vollbildwerbung</color>
      genie\xDFen.,\u201C Vous pouvez maintenant profiter du jeu sans <color=#fff773>banni\xE8res
      publicitaires</color> ni <color=#fff773>pubs plein \xE9cran</color>. \u201D,\"\"\"Art\u0131k
      oyunun tad\u0131n\u0131 <color=#fff773>afi\u015F reklamlar</color> ve <color=#fff773>tam
      ekran reklamlar</color> olmadan \xE7\u0131karabilirsiniz.\"\"\",\u73B0\u5728\u4F60\u53EF\u4EE5\u4EAB\u53D7\u6E38\u620F\u800C\u6CA1\u6709
      <color=#fff773>\u6A2A\u5E45\u5E7F\u544A</color> \u548C <color=#fff773>\u5168\u5C4F\u5E7F\u544A</color>
      \u7684\u6253\u6270\u3002,Sekarang kamu bisa menikmati game tanpa <color=#fff773>iklan
      banner</color> dan <color=#fff773>iklan layar penuh</color>.,\u73FE\u5728\u4F60\u53EF\u4EE5\u4EAB\u53D7\u904A\u6232\u800C\u6C92\u6709
      <color=#fff773>\u6A6B\u5E45\u5EE3\u544A</color> \u548C <color=#fff773>\u5168\u5C4F\u5EE3\u544A</color>
      \u7684\u6253\u64FE\u3002,Ora puoi goderti il gioco senza <color=#fff773>banner
      ads</color> e <color=#fff773>full-screen ads</color>.,\u3053\u308C\u3067<color=#fff773>\u30D0\u30CA\u30FC\u5E83\u544A</color>\u3084<color=#fff773>\u5168\u753B\u9762\u5E83\u544A</color>\u306A\u3057\u3067\u30B2\u30FC\u30E0\u3092\u697D\u3057\u3081\u307E\u3059\u3002,\uC774\uC81C
      <color=#fff773>\uBC30\uB108 \uAD11\uACE0</color> \uBC0F <color=#fff773>\uC804\uCCB4
      \uD654\uBA74 \uAD11\uACE0</color> \uC5C6\uC774 \uAC8C\uC784\uC744 \uC990\uAE38
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.,\u0422\u0435\u043F\u0435\u0440 \u0432\u0438
      \u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u0436\u0443\u0432\u0430\u0442\u0438\u0441\u044F
      \u0433\u0440\u043E\u044E \u0431\u0435\u0437 <color=#fff773>\u0431\u0430\u043D\u0435\u0440\u043D\u043E\u0457
      \u0440\u0435\u043A\u043B\u0430\u043C\u0438</color> \u0442\u0430 <color=#fff773>\u043F\u043E\u0432\u043D\u043E\u0435\u043A\u0440\u0430\u043D\u043D\u043E\u0457
      \u0440\u0435\u043A\u043B\u0430\u043C\u0438</color>.,,\r\nUIRemoveAdsRewardButton,Text,,Got
      it!,\xA1Entendido!,Entendi!,\u041F\u043E\u043D\u044F\u0442\u043D\u043E!,Verstanden!,Compris
      !,Anlad\u0131m!,\u77E5\u9053\u4E86\uFF01,Mengerti!,\u77E5\u9053\u4E86\uFF01,Fatto!,\u308F\u304B\u3063\u305F\uFF01,\uC54C\uACA0\uC2B5\uB2C8\uB2E4!,\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u0432!,,\r\nUIPhotoAlbumPhotoLockTips,Text,,Continue
      to clear levels to unlock.,Contin\xFAa superando niveles para desbloquear.,Continue
      a completar n\xEDveis para desbloquear.,\"\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C.\",\"Weiter
      Levels freischalten, um zu entsperren.\",Continuez \xE0 terminer des niveaux
      pour d\xE9bloquer.,Kilidi a\xE7mak i\xE7in b\xF6l\xFCmleri temizlemeye devam
      edin.,\u7EE7\u7EED\u901A\u5173\u4EE5\u89E3\u9501\u3002,Terus selesaikan level
      untuk membuka kunci.,\u7E7C\u7E8C\u901A\u95DC\u4EE5\u89E3\u9396\u3002,Continua
      a completare i livelli per sbloccare.,\u30EC\u30D9\u30EB\u3092\u30AF\u30EA\u30A2\u3057\u3066\u30A2\u30F3\u30ED\u30C3\u30AF\u3092\u7D9A\u3051\u3088\u3046\u3002,\uB808\uBCA8\uC744
      \uACC4\uC18D \uD074\uB9AC\uC5B4\uD558\uC5EC \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694.,\"\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439\u0442\u0435
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0438 \u0440\u0456\u0432\u043D\u0456,
      \u0449\u043E\u0431 \u0440\u043E\u0437\u0431\u043B\u043E\u043A\u0443\u0432\u0430\u0442\u0438.\",,\r\n822,,,,,,,,,,,,,,,,,,\r\nUINetworkDisconnectedButton,Text,,Got
      it,Listo,Ok,\u041F\u043E\u043D\u044F\u0442\u043D\u043E,Verstanden,Compris !,Anlad\u0131m,\u77E5\u9053\u4E86,Mengerti,\u77E5\u9053\u4E86,Fatto!,\u4E86\u89E3\uFF01,\uC54C\uACA0\uC2B5\uB2C8\uB2E4!,\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u0432!,,\r\nUINetworkDisconnectedDes1,Text,,\"The
      network connection is unstable, please check the network\",\"La conexi\xF3n
      de red es inestable, verifique la red.\",\"A conex\xE3o de rede est\xE1 inst\xE1vel,
      verifique a rede.\",\"\u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
      \u0441 \u0441\u0435\u0442\u044C\u044E \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\",\"Die
      Netzwerkverbindung ist instabil, bitte \xFCberpr\xFCfen Sie das Netzwerk.\",\"La
      connexion r\xE9seau est instable, veuillez v\xE9rifier votre connexion.\",\"A\u011F
      ba\u011Flant\u0131s\u0131 karars\u0131z, l\xFCtfen ba\u011Flant\u0131n\u0131z\u0131
      kontrol edin.\",\u7F51\u7EDC\u8FDE\u63A5\u4E0D\u7A33\u5B9A\uFF0C\u8BF7\u68C0\u67E5\u7F51\u7EDC,\"Koneksi
      jaringan tidak stabil, silakan periksa jaringan\",\u7DB2\u8DEF\u9023\u63A5\u4E0D\u7A69\u5B9A\uFF0C\u8ACB\u6AA2\u67E5\u7DB2\u8DEF,\"La
      connessione di rete \xE8 instabile, controlla la rete\",\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u63A5\u7D9A\u304C\u4E0D\u5B89\u5B9A\u3067\u3059\u3002\u30CD\u30C3\u30C8\u30EF\u30FC\u30AF\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044\u3002,\uB124\uD2B8\uC6CC\uD06C
      \uC5F0\uACB0\uC774 \uBD88\uC548\uC815\uD569\uB2C8\uB2E4. \uB124\uD2B8\uC6CC\uD06C\uB97C
      \uD655\uC778\uD558\uC138\uC694.,\"\u0417\u2019\u0454\u0434\u043D\u0430\u043D\u043D\u044F
      \u0437 \u043C\u0435\u0440\u0435\u0436\u0435\u044E \u043D\u0435\u0441\u0442\u0430\u0431\u0456\u043B\u044C\u043D\u0435,
      \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430, \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
