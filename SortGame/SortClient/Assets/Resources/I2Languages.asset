      - "\uAC00\uC7A5 \uC21C\uC218\uD55C \uD558\uC591"
      - "\u041D\u0430\u0439\u0447\u0438\u0441\u0442\u0456\u0448\u0438\u0439 \u0431\u0456\u043B\u0438\u0439"
