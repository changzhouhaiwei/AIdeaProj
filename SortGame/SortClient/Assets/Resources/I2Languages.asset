      - "\r"
      Flags: 000000000000000000000000000000
      Languages_Touch: []
    - Term: JungleQuest_FailCooldownDes
      TermType: 0
      Description: "\u5931\u8D25\u540E\u4E3B\u9875\uFF0C\u540E\u63A5\u5012\u8BA1\u65F6"
      Languages:
      - 'You failed this round. Next round starts in:'
      - 'Fallaste esta ronda. La siguiente empieza en:'
      - "Voc\xEA falhou nesta rodada. A pr\xF3xima come\xE7a em:"
      - "\u0422\u044B \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B \u044D\u0442\u043E\u0442
        \u0440\u0430\u0443\u043D\u0434. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
        \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437:"
      - "Diese Runde ist gescheitert. N\xE4chste Runde startet in:"
      - "Tu as \xE9chou\xE9 cette manche. Prochaine manche dans :"
      - "Bu turu kaybettin. Sonraki tur ba\u015Fl\u0131yor:"
      - "\u672C\u8F6E\u6311\u6218\u5931\u8D25\u3002\u4E0B\u4E00\u8F6E\u5F00\u59CB\u5012\u8BA1\u65F6\uFF1A"
      - 'Kamu gagal di ronde ini. Ronde berikutnya mulai dalam:'
      - "\u672C\u8F2A\u6311\u6230\u5931\u6557\u3002\u4E0B\u4E00\u8F2A\u958B\u59CB\u5012\u8A08\u6642\uFF1A"
      - 'Hai fallito questo round. Il prossimo inizia tra:'
      - "\u3053\u306E\u30E9\u30A6\u30F3\u30C9\u306F\u5931\u6557\u3002\u6B21\u306E\u30E9\u30A6\u30F3\u30C9\u958B\u59CB\u307E\u3067\uFF1A"
      - "\uC774\uBC88 \uB77C\uC6B4\uB4DC \uC2E4\uD328. \uB2E4\uC74C \uB77C\uC6B4\uB4DC
        \uC2DC\uC791\uAE4C\uC9C0:"
      - "\u0422\u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432 \u0446\u0435\u0439
        \u0440\u0430\u0443\u043D\u0434. \u041D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439
        \u043F\u043E\u0447\u043D\u0435\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437:"
      - "\r"
      Flags: 000000000000000000000000000000
      Languages_Touch: []
