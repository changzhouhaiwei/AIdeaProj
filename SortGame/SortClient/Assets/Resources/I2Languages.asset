      - "\uACB8\uC190\uD55C \uC6B0\uC544\uD568"
      - "\u0421\u043A\u0440\u043E\u043C\u043D\u0430 \u0433\u0440\u0430\u0446\u0456\u044F"
      - "\"\u0411\u043E \u0447\u0430\u0441\u0442\u043E, \u043A\u043E\u043B\u0438
        \u044F \u043B\u0435\u0436\u0443 \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443
        \u0434\u0438\u0432\u0430\u043D\u0456, \u0443 \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u043C\u0443
        \u0447\u0438 \u0437\u0430\u0434\u0443\u043C\u043B\u0438\u0432\u043E\u043C\u0443
        \u043D\u0430\u0441\u0442\u0440\u043E\u0457, \u0432\u043E\u043D\u0438 \u0441\u043F\u0430\u043B\u0430\u0445\u0443\u044E\u0442\u044C
        \u043F\u0435\u0440\u0435\u0434 \u0442\u0438\u043C \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u0456\u043C
        \u043E\u043A\u043E\u043C, \u044F\u043A\u0435 \u0454 \u0431\u043B\u0430\u0436\u0435\u043D\u0441\u0442\u0432\u043E\u043C
        \u0441\u0430\u043C\u043E\u0442\u043D\u043E\u0441\u0442\u0456; \u0456 \u0442\u043E\u0434\u0456
        \u043C\u043E\u0454 \u0441\u0435\u0440\u0446\u0435 \u043D\u0430\u043F\u043E\u0432\u043D\u044E\u0454\u0442\u044C\u0441\u044F
        \u0440\u0430\u0434\u0456\u0441\u0442\u044E \u0439 \u0442\u0430\u043D\u0446\u044E\u0454
        \u0437 \u043D\u0430\u0440\u0446\u0438\u0441\u0430\u043C\u0438. \u2013 \u0412\u0456\u043B\u044C\u044F\u043C
        \u0412\u043E\u0440\u0434\u0441\u0432\u043E\u0440\u0442, \u042F \u0431\u043B\u0443\u043A\u0430\u0432
